      "severity": "ERROR",
      "params": {
        "terms": ["rightmostElement.xMm", "rightmostElement.widthMm", "wall.closingMm"],
        "target": "wall.designLengthMm",
        "skipWhenMissing": ["wall.closingMm"]
      },
      "paramRefs": {
        "toleranceMm": "measure.closureToleranceMm"
      },
      "prerequisites": ["WALL_COMPLETE", "ELEMENT_HAS_WIDTH"],
      "acknowledgeable": false,
      "projectTypes": ["KITCHEN", "CLOSET"],
      "messageEsMx": "Muro {wallCode}: cierre {sum} mm vs. muro {length} mm (Δ {delta} mm)."
    },
    {
      "code": "WALL_CLOSURE_MISSING",
      "ruleSet": "MEASUREMENT",
      "scope": "WALL",
      "kind": "REQUIRED_FIELDS",
