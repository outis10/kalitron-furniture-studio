      "scope": "WALL",
      "kind": "REQUIRED_FIELDS",
      "severity": "ERROR",
      "params": {
        "fields": ["lengthFloorMm", "length900Mm", "lengthCeilingMm", "ceilingHeightLeftMm", "ceilingHeightRightMm"]
